{
  "name": "hematoboard-v2-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fixture": "uv run python ../scripts/build_ui_fixture.py --output public/dashboard_projection.v1.json",
    "dev": "npm run fixture && vite --host 127.0.0.1 --port 8913",
    "dev:static": "vite --host 127.0.0.1 --port 8913",
    "build:app": "tsc --noEmit && vite build",
    "build": "npm run fixture && npm run build:app",
    "test:ui": "npm run fixture && playwright test tests/dashboard.spec.ts",
    "screenshots": "npm run fixture && playwright test tests/screenshots.spec.ts",
    "qa:candidate": "node scripts/run-candidate-qa.mjs",
    "qa:candidate:fast": "node scripts/run-candidate-qa.mjs --profile data_only --verified-ui-baseline verified-ui-baseline.json"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.3.1",
    "@mui/material": "9.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
